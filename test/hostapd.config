# Minimal hostapd build for the e2e test: wired + MACsec authenticator with
# the built-in EAP-TLS server and RADIUS server. No Wi-Fi. Written from
# scratch rather than derived from defconfig: hostap treats any defined
# CONFIG_x as enabled, and defconfig's Wi-Fi-centric set does not link
# without nl80211.
CONFIG_DRIVER_WIRED=y
CONFIG_DRIVER_MACSEC_LINUX=y
CONFIG_MACSEC=y
CONFIG_LIBNL32=y
CONFIG_DRIVER_NONE=y
CONFIG_EAP=y
CONFIG_EAP_TLS=y
CONFIG_EAP_MD5=y
CONFIG_RADIUS_SERVER=y
CONFIG_TLS=openssl
CONFIG_TLSV11=y
CONFIG_TLSV12=y
CONFIG_PKCS12=y
CONFIG_IPV6=y
CONFIG_GETRANDOM=y
CONFIG_NO_RANDOM_POOL=y
