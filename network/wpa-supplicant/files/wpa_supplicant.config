# wpa_supplicant build configuration for the Talos wpa-supplicant extension.
# Wired 802.1X + MACsec only: no Wi-Fi drivers, no AP/P2P/mesh code.
# OpenSSL TLS with the ENGINE API compiled OUT (no CONFIG_SMARTCARD) so hostap
# takes the OpenSSL 3 provider path for pkcs11: URIs (pkcs11-provider ->
# pkcs11-tpm). NOTE: hostap treats ANY defined CONFIG_x as enabled; features
# are disabled by omission, never by "=n".
CONFIG_DRIVER_WIRED=y
CONFIG_DRIVER_MACSEC_LINUX=y
CONFIG_MACSEC=y
CONFIG_LIBNL32=y
CONFIG_IEEE8021X_EAPOL=y
CONFIG_EAP_TLS=y
CONFIG_EAP_PEAP=y
CONFIG_EAP_TTLS=y
CONFIG_EAP_MSCHAPV2=y
CONFIG_EAP_MD5=y
CONFIG_EAP_GTC=y
CONFIG_PKCS12=y
CONFIG_CTRL_IFACE=y
CONFIG_TLS=openssl
CONFIG_TLSV11=y
CONFIG_TLSV12=y
CONFIG_GETRANDOM=y
CONFIG_IPV6=y
CONFIG_DEBUG_FILE=y
CONFIG_DEBUG_SYSLOG=y
CONFIG_NO_CONFIG_WRITE=y
CONFIG_NO_RANDOM_POOL=y
